<ui:FluentWindow x:Class="Forge.Views.SubmitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Forge" Height="520" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Background="{DynamicResource ForgeBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Submit" CanMaximize="False" ShowMinimize="False" ShowMaximize="False"/>
        <StackPanel Grid.Row="1" Margin="16">
            <TextBlock x:Name="RepoText" FontWeight="Bold" Margin="0,0,0,8"/>

            <TextBlock Text="Files to commit and push" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
                <ListBox x:Name="FilesList" BorderThickness="0" Height="100" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Border>

            <TextBlock x:Name="CascadeHeader" Text="Pin updates (cascading up to the superproject)" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
            <Border x:Name="CascadeBorder" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,12">
                <ListBox x:Name="CascadeList" BorderThickness="0" Height="70" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Border>

            <TextBlock Text="Commit message" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox x:Name="CommitMessageBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"
                     ToolTip="Used as the commit message here, and reused as the subject line for every pin-bump commit above."/>

            <TextBlock x:Name="WarningText" Foreground="{DynamicResource ForgeWarnBrush}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Submit" Width="90" IsDefault="True" Click="Ok_Click"
                        Background="{DynamicResource ForgeAccentBrush}" Foreground="{DynamicResource ForgeOnAccentBrush}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
