<ui:FluentWindow x:Class="Forge.Views.HousekeepingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Forge" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Background="{DynamicResource ForgeBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Housekeeping" CanMaximize="False" ShowMinimize="False"/>

        <StackPanel Grid.Row="1" Margin="16,8,16,8">
            <TextBlock Text="Build caches" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16">
                <ItemsControl x:Name="FoldersList" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="6,6">
                                <Button DockPanel.Dock="Right" Content="Clean" Width="70" Click="Clean_Click" Tag="{Binding}"
                                        IsEnabled="{Binding CanClean}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding SizeText}" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="LFS cache" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6">
                <DockPanel Margin="10">
                    <Button DockPanel.Dock="Right" Content="Prune" Width="70" Click="Prune_Click"/>
                    <StackPanel>
                        <TextBlock Text="Remove local LFS objects nothing still references."/>
                        <TextBlock x:Name="PruneResultText" FontSize="11" Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16">
            <Button Content="Close" Width="80" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
