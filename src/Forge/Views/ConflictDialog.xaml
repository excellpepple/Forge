<ui:FluentWindow x:Class="Forge.Views.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Forge" Height="340" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Background="{DynamicResource ForgeBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Resolve Conflict" CanMaximize="False" ShowMinimize="False"/>
        <StackPanel Grid.Row="1" Margin="16">
            <TextBlock x:Name="PathText" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Text="This is a binary asset -- Git can't merge it line by line. Pick which version to keep."
                       TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,16"/>

            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Keep Mine" Width="100" Click="KeepMine_Click"
                            Background="{DynamicResource ForgeAccentBrush}" Foreground="{DynamicResource ForgeOnAccentBrush}"/>
                    <StackPanel>
                        <TextBlock Text="Mine (your current branch)" FontWeight="Medium"/>
                        <TextBlock x:Name="OursText" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Keep Theirs" Width="100" Click="KeepTheirs_Click"/>
                    <StackPanel>
                        <TextBlock Text="Theirs (what you're merging in)" FontWeight="Medium"/>
                        <TextBlock x:Name="TheirsText" Opacity="0.75" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
