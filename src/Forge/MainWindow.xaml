<ui:FluentWindow x:Class="Forge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Forge.Views"
        xmlns:conv="clr-namespace:Forge.Converters"
        mc:Ignorable="d"
        Title="Forge" Height="720" Width="1150" MinHeight="500" MinWidth="800"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Background="{DynamicResource ForgeBackgroundBrush}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToCollapsed"/>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ForgeAccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <ContextMenu x:Key="SubmoduleContextMenu">
            <MenuItem Header="Switch Branch..." Click="SwitchBranchButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSwap24" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Set Watch Branch..." Click="SetWatchBranchButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Eye24" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Check for Updates" Click="CheckUpdatesButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Alert24" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Refresh Branch Lists" Click="RefreshBranchListsButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="CloudArrowDown24" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Shelve..." Click="ShelveButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Archive32" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Open in External Git Tool..." Click="OpenAdvancedViewButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Open28" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Refresh" Click="RefreshSubmodulesButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSync24" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <Style x:Key="SubmoduleTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="ContextMenu" Value="{StaticResource SubmoduleContextMenu}"/>
            <!-- Bubbling, not the tunneling Preview version: bubbling starts
                 at the actual clicked (innermost) item and works outward, so
                 that item's handler runs, and marks Handled, before the
                 event ever reaches a parent's handler. The tunneling Preview
                 version runs parent first, which is why right-clicking a
                 nested submodule was selecting its parent instead. -->
            <EventSetter Event="MouseRightButtonDown" Handler="TreeItem_MouseRightButtonDown"/>
        </Style>

        <ContextMenu x:Key="FileContextMenu">
            <MenuItem Header="Lock" Click="LockSelectedButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="LockClosed24" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Unlock" Click="UnlockSelectedButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="LockOpen24" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Notify Me When Unlocked" Click="NotifyOnUnlockButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="Alert24" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="History..." Click="ViewHistoryButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="History28" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Resolve Conflict..." Click="ResolveConflictButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSplit24" Foreground="{DynamicResource ForgeDangerTextBrush}"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Refresh" Click="RefreshFilesButton_Click">
                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSync24" Foreground="{DynamicResource ForgeAccentBrush}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <Style x:Key="FileTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="ContextMenu" Value="{StaticResource FileContextMenu}"/>
            <Setter Property="Padding" Value="2,1"/>
            <EventSetter Event="MouseRightButtonDown" Handler="TreeItem_MouseRightButtonDown"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="AppTitleBar" Title="Forge">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Fire24" Foreground="{DynamicResource ForgeAccentBrush}"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1">
            <!-- Failure banner -->
            <Border x:Name="FailBanner" Background="{DynamicResource ForgeDangerFillBrush}" Padding="10" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Padding="8,2" Click="DismissBanner_Click"
                            ToolTip="Hide this message. It doesn't undo anything -- the operation already stopped safely."/>
                    <TextBlock x:Name="FailBannerText" TextWrapping="Wrap" Foreground="{DynamicResource ForgeOnDangerBrush}" FontWeight="Bold"/>
                </DockPanel>
            </Border>

            <!-- In-app notification (e.g. "unlock freed"), shown here instead of
                 a Windows toast. Auto-dismisses itself; see ShowNotifyBanner. -->
            <Border x:Name="NotifyBanner" Background="{DynamicResource ForgeAccentSoftBrush}" Padding="10" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Padding="8,2" Click="DismissNotifyBanner_Click"/>
                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Alert24" Margin="0,0,8,0" Foreground="{DynamicResource ForgeMatchBrush}"/>
                    <TextBlock x:Name="NotifyBannerText" TextWrapping="Wrap" Foreground="{DynamicResource ForgeMatchBrush}" FontWeight="Bold"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource ForgeSidebarBackgroundBrush}">
                <DockPanel>
                    <!-- Bottom of the sidebar, added in bottom-to-top visual order:
                         Settings pinned at the very bottom, project switcher just above it. -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="SettingsNavIcon" Symbol="Settings24" Margin="0,0,10,0"/>
                                <TextBlock x:Name="SettingsNavLabel" Text="Settings"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="10,10,10,10">
                        <TextBlock x:Name="ProjectTitleText" Margin="2,0,0,8" FontWeight="Medium" TextTrimming="CharacterEllipsis" Text="No project open"/>
                        <Button x:Name="OpenProjectButton" Content="Open Project..." Padding="10,6" Margin="0,0,0,8"
                                Click="OpenProjectButton_Click" HorizontalAlignment="Stretch"
                                ToolTip="Pick a folder containing Tools\ProjectWorkflow.psm1 and project.config.json."/>
                        <Button Content="Register a Project..." Padding="10,6" Margin="0,0,0,8"
                                Click="RegisterProjectButton_Click" HorizontalAlignment="Stretch"
                                ToolTip="Point Forge at an Unreal project folder that isn't set up for Forge yet."/>
                        <ComboBox x:Name="RecentProjectsCombo" HorizontalAlignment="Stretch"
                                  SelectionChanged="RecentProjectsCombo_SelectionChanged"
                                  ToolTip="Projects you've opened before. Pick one to reopen it."/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <Button x:Name="OverviewNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Overview" IsEnabled="False"
                                ToolTip="Project summary and the two things you'll do most often.">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="OverviewNavIcon" Symbol="Home24" Margin="0,0,10,0"/>
                                <TextBlock x:Name="OverviewNavLabel" Text="Overview"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SubmodulesNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Submodules" IsEnabled="False"
                                ToolTip="Every engine/game/art/plugin repo this project is made of, and their branches.">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="SubmodulesNavIcon" Symbol="BranchFork24" Margin="0,0,10,0"/>
                                <TextBlock x:Name="SubmodulesNavLabel" Text="Submodules"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FilesNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Files" IsEnabled="False"
                                ToolTip="Every tracked file across every repo, with its status, lock and download state.">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="FilesNavIcon" Symbol="Folder24" Margin="0,0,10,0"/>
                                <TextBlock x:Name="FilesNavLabel" Text="Files"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HistoryNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="History" IsEnabled="False"
                                ToolTip="Commit graph for a repo -- simplified by default, with a full view available.">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="HistoryNavIcon" Symbol="History28" Margin="0,0,10,0"/>
                                <TextBlock x:Name="HistoryNavLabel" Text="History"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BuildNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Build" IsEnabled="False"
                                ToolTip="Sync a subset of submodules, and control how the editor gets built.">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="BuildNavIcon" Symbol="Wrench24" Margin="0,0,10,0"/>
                                <TextBlock x:Name="BuildNavLabel" Text="Build"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="LogNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Log" IsEnabled="False"
                                ToolTip="Live output from whatever Forge is running right now.">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="LogNavIcon" Symbol="DocumentText24" Margin="0,0,10,0"/>
                                <TextBlock x:Name="LogNavLabel" Text="Log"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="HelpNavButton" Style="{StaticResource NavButtonStyle}" Click="NavButton_Click" Tag="Help"
                                ToolTip="Documentation for the open project, and for Forge itself.">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="HelpNavIcon" Symbol="QuestionCircle24" Margin="0,0,10,0"/>
                                <TextBlock x:Name="HelpNavLabel" Text="Help"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">

                <Grid x:Name="OverviewPage" Visibility="Collapsed" Margin="24">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock x:Name="OverviewTitle" FontSize="20" FontWeight="Bold" Text="No project open"/>
                        <TextBlock x:Name="OverviewRoot" Margin="0,4,0,20" Opacity="0.7"/>
                        <TextBlock x:Name="OverviewBranch" Margin="0,0,0,4"
                                   ToolTip="The branch this project's pins (which versions of the engine/game/art go together) are read from."/>
                        <TextBlock x:Name="OverviewEditorTarget" Margin="0,0,0,4"
                                   ToolTip="The Unreal build target Forge compiles when you click Build."/>
                        <TextBlock x:Name="OverviewUProject" Margin="0,0,0,20"
                                   ToolTip="The .uproject file this build opens once it's done."/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="QuickSyncButton" Content="Sync" Width="130" Height="34" Margin="0,0,10,0" Click="QuickSyncButton_Click"
                                    ToolTip="Get everyone's latest work: updates the engine, game, art and plugins to the versions the team pinned together. Safe -- refuses if you have unsaved changes in the way."/>
                            <Button x:Name="QuickBuildButton" Content="Build &amp; Launch" Width="160" Height="34" Click="QuickBuildButton_Click"
                                    Background="{DynamicResource ForgeAccentBrush}" Foreground="{DynamicResource ForgeOnAccentBrush}"
                                    ToolTip="Build the editor with default options and open it when done. For more control, use the Build tab."/>
                        </StackPanel>

                        <Border Style="{StaticResource ToolbarCardStyle}" Margin="0,24,0,0" Padding="16,12" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Your stuff" FontWeight="Medium" Margin="0,0,0,8"/>
                                <TextBlock x:Name="YourStuffUnpushedText" Margin="0,0,0,4"
                                           ToolTip="Local commits not yet pushed to origin, across every repo."/>
                                <TextBlock x:Name="YourStuffLocksText" Margin="0,0,0,4"
                                           ToolTip="LFS locks you currently hold."/>
                                <TextBlock x:Name="YourStuffOutdatedText"
                                           ToolTip="LFS files not yet downloaded on this machine (still pointer files)."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SubmodulesPage" Visibility="Collapsed" Margin="24">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarCardStyle}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RefreshSubmodulesButton" Style="{StaticResource ToolbarButtonStyle}" Click="RefreshSubmodulesButton_Click"
                                        ToolTip="Re-read the current state of every submodule from disk.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SwitchBranchButton" Style="{StaticResource ToolbarButtonStyle}" Click="SwitchBranchButton_Click"
                                        ToolTip="Switch the selected submodule to a different branch. Also updates whatever is nested inside it to match that branch. Refuses if there's unsaved work in the way.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSwap24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="Switch Branch..."/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SetWatchBranchButton" Style="{StaticResource ToolbarButtonStyle}" Click="SetWatchBranchButton_Click"
                                        ToolTip="Pick a branch to watch for new commits on the selected submodule -- separate from the pinned branch, and purely informational. Doesn't change anything on disk.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Eye24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="Set Watch Branch..."/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CheckUpdatesButton" Style="{StaticResource ToolbarButtonStyle}" Click="CheckUpdatesButton_Click"
                                        ToolTip="Check every watched branch for new commits upstream. Just reports -- never changes anything.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Alert24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="Check for Updates"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RefreshBranchListsButton" Style="{StaticResource ToolbarButtonStyle}" Click="RefreshBranchListsButton_Click"
                                        ToolTip="Re-fetch the list of available branches from origin for every submodule, in the background. Forge also does this automatically on open and periodically. To refresh just one submodule, use the Refresh button inside the branch picker.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="CloudArrowDown24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="Refresh Branch Lists"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShelveButton" Style="{StaticResource ToolbarButtonStyle}" Click="ShelveButton_Click"
                                        ToolTip="Save the selected submodule's uncommitted changes for later, so Sync has a clean tree to work with.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Archive32" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="Shelve..."/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OpenAdvancedViewButton" Style="{StaticResource ToolbarButtonStyle}" Click="OpenAdvancedViewButton_Click"
                                        ToolTip="Opens the selected submodule in whichever external Git GUI Forge finds installed (Fork, then SourceGit), for anything Forge doesn't cover. Entirely optional -- Forge doesn't require either one.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Open28" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock x:Name="OpenAdvancedViewButtonLabel" Text="Open in External Git Tool..."/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="BranchRefreshStatusText" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.7"/>
                            </StackPanel>
                        </Border>
                        <TreeView x:Name="SubmodulesTree" SelectedItemChanged="SubmodulesTree_SelectedItemChanged"
                                  ItemContainerStyle="{StaticResource SubmoduleTreeItemStyle}"
                                  ToolTip="Select a submodule, then use the toolbar above or right-click for the same options.">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Width="190" Margin="0,0,14,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding State.Path}"/>
                                        <TextBlock Text="{Binding State.State}" Width="80" Margin="0,0,14,0"
                                                   VerticalAlignment="Center" Foreground="{Binding StateBrush}"
                                                   ToolTip="Match: on the pinned commit. Ahead: newer than the pin (normal mid-work). Behind/Diverged/Missing: needs a Sync."/>
                                        <StackPanel Width="280" Margin="0,0,14,0" VerticalAlignment="Center"
                                                    ToolTip="The branch actually checked out. The 'pinned:' line (if shown) is what the team's pin expects instead.">
                                            <TextBlock Text="{Binding State.BranchName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding State.PinnedAnnotation}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding State.ShortHead}" Width="80" Margin="0,0,14,0"
                                                   VerticalAlignment="Center" Opacity="0.7" FontFamily="Consolas"
                                                   ToolTip="Short commit hash currently checked out."/>
                                        <TextBlock Text="{Binding WatchInfo}" VerticalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Grid>

                <Grid x:Name="FilesPage" Visibility="Collapsed" Margin="24">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarCardStyle}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RefreshFilesButton" Style="{StaticResource ToolbarButtonStyle}" Click="RefreshFilesButton_Click"
                                        ToolTip="Re-read file status, lock and download state for every repo (except the engine, which is too large to scan this way).">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FilesFilterAllButton" Content="All" Style="{StaticResource SegButtonStyle}" Click="FilesFilter_Click" Tag="All" Margin="16,0,0,0"/>
                                <Button x:Name="FilesFilterChangedButton" Content="Changed" Style="{StaticResource SegButtonStyle}" Click="FilesFilter_Click" Tag="Changed"/>
                                <Button x:Name="FilesFilterLockedButton" Content="Locked" Style="{StaticResource SegButtonStyle}" Click="FilesFilter_Click" Tag="Locked"/>
                                <Button x:Name="FilesFilterOutdatedButton" Content="Not downloaded" Style="{StaticResource SegButtonStyle}" Click="FilesFilter_Click" Tag="NotDownloaded"/>
                                <Button x:Name="FilesFilterStaleButton" Content="Stale locks" Style="{StaticResource SegButtonStyle}" Click="FilesFilter_Click" Tag="Stale"/>
                                <TextBox x:Name="FilesSearchBox" Width="200" Margin="16,0,0,0" VerticalContentAlignment="Center"
                                         TextChanged="FilesSearchBox_TextChanged" ToolTip="Filter by file or folder name."/>
                                <TextBlock x:Name="FilesStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"/>
                            </StackPanel>
                        </Border>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarCardStyle}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LockSelectedButton" Style="{StaticResource ToolbarButtonStyle}" Click="LockSelectedButton_Click"
                                        ToolTip="Lock the selected file so only you can check in changes to it. Requires the LFS feature flag.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="LockClosed24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="Lock"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="UnlockSelectedButton" Style="{StaticResource ToolbarButtonStyle}" Click="UnlockSelectedButton_Click"
                                        ToolTip="Release a lock you hold on the selected file.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="LockOpen24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="Unlock"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NotifyOnUnlockButton" Style="{StaticResource ToolbarButtonStyle}" Click="NotifyOnUnlockButton_Click"
                                        ToolTip="Get a notification the next time someone else's lock on the selected file is released.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Alert24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="Notify Me When Unlocked"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ViewHistoryButton" Style="{StaticResource ToolbarButtonStyle}" Click="ViewHistoryButton_Click"
                                        ToolTip="See every commit that touched the selected file, and open, diff or restore an old version.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="History28" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="History..."/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ResolveConflictButton" Style="{StaticResource ToolbarButtonStyle}" Click="ResolveConflictButton_Click"
                                        ToolTip="Pick which version to keep when the same asset was changed on both sides.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSplit24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeDangerTextBrush}"/>
                                        <TextBlock Text="Resolve Conflict..."/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="CheckedFilesStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"/>
                                <Button x:Name="SubmitButton" Style="{StaticResource ToolbarButtonStyle}" Click="SubmitButton_Click"
                                        HorizontalAlignment="Right" Margin="12,0,0,0"
                                        Background="{DynamicResource ForgeAccentBrush}" Foreground="{DynamicResource ForgeOnAccentBrush}"
                                        ToolTip="Commit the checked files, push, release their locks, and bump every ancestor submodule's pin up to the superproject.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="CloudArrowUp24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeOnAccentBrush}"/>
                                        <TextBlock Text="Submit..."/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TreeView x:Name="FilesTree" ToolTip="Tracked files across every repo except the engine. Right-click a file for lock actions."
                                  ItemContainerStyle="{StaticResource FileTreeItemStyle}"
                                  SelectedItemChanged="FilesTree_SelectedItemChanged"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <DockPanel MinHeight="24">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, Mode=OneWay}" Click="FileCheck_Click"
                                                  Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}"
                                                  Width="18" VerticalAlignment="Center" Margin="0,0,2,0"
                                                  ToolTip="Check to include this file in the next Submit."/>
                                        <ui:SymbolIcon DockPanel.Dock="Left" VerticalAlignment="Center" Margin="2,0,7,0"
                                                       FontSize="14" Opacity="0.5" Foreground="{DynamicResource ForgeIconBrush}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Folder24"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFile}" Value="True">
                                                            <Setter Property="Symbol" Value="DocumentText24"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DownloadText}" FontSize="11" Opacity="0.6"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Visibility="{Binding DownloadText, Converter={StaticResource EmptyToCollapsed}}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding LockText}" FontSize="11" Opacity="0.6"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                                   Visibility="{Binding LockText, Converter={StaticResource EmptyToCollapsed}}"/>
                                        <Border DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" CornerRadius="4" Padding="7,2"
                                                Background="{Binding StatusBgBrush}" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding StatusBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Grid>

                <Grid x:Name="HistoryPage" Visibility="Collapsed" Margin="24">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarCardStyle}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="HistoryRepoCombo" Width="220" SelectionChanged="HistoryRepoCombo_SelectionChanged"
                                          ToolTip="Which repo's commit graph to show."/>
                                <Button x:Name="HistorySimpleButton" Content="Simple" Style="{StaticResource SegButtonStyle}" Click="HistoryMode_Click" Tag="Simple" Margin="16,0,0,0"/>
                                <Button x:Name="HistoryFullButton" Content="Full" Style="{StaticResource SegButtonStyle}" Click="HistoryMode_Click" Tag="Full"/>
                                <Button x:Name="RefreshHistoryButton" Style="{StaticResource ToolbarButtonStyle}" Click="RefreshHistoryButton_Click" Margin="16,0,0,0"
                                        ToolTip="Re-read the commit graph for the selected repo.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeAccentBrush}"/>
                                        <TextBlock Text="Refresh"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="HistoryStatusText" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Canvas x:Name="HistoryGraphCanvas" Grid.Column="0"/>
                                <ItemsControl x:Name="HistoryCommitList" Grid.Column="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="24" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1"
                                                    Background="Transparent" MouseDown="HistoryCommitRow_MouseDown" Cursor="Hand"
                                                    ToolTip="Double-click: if this bumped a submodule pin, see the real commits it pulled in.">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ShortSha}" Width="70" FontFamily="Consolas" Opacity="0.7"/>
                                                    <TextBlock Text="{Binding Subject}" Width="360" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                                                    <TextBlock Text="{Binding AuthorName}" Width="140" Opacity="0.75"/>
                                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:g}'}" Opacity="0.6"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>

                <Grid x:Name="BuildPage" Visibility="Collapsed" Margin="24">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Sync" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <RadioButton x:Name="SyncAllRadio" Content="Sync everything (recommended)" GroupName="SyncScope" IsChecked="True" Margin="0,0,0,6"
                                     ToolTip="The same full sync as the Overview tab's Sync button and Sync.bat."/>
                        <RadioButton x:Name="SyncSelectedRadio" Content="Sync only the selected submodule(s) below" GroupName="SyncScope" Margin="0,0,0,6"
                                     ToolTip="Update just these top-level submodules (e.g. only the engine) instead of everything. Faster when you know only one piece changed."/>
                        <Border Margin="24,0,0,10" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ListBox x:Name="SyncSubmodulesList" SelectionMode="Multiple" Height="90" BorderThickness="0"
                                     ToolTip="Ctrl-click or Shift-click to select more than one."/>
                        </Border>
                        <Button x:Name="RunSyncButton" Content="Run Sync" Width="140" Height="30" HorizontalAlignment="Left" Margin="0,0,0,28" Click="RunSyncButton_Click"
                                ToolTip="Run the sync scope chosen above."/>

                        <TextBlock Text="Build" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <CheckBox x:Name="NoBuildCheck" Content="No build -- just launch the editor" Margin="0,0,0,6"
                                  ToolTip="Skip compiling and open the editor immediately. Only safe if nothing changed in C++ since your last build."/>
                        <CheckBox x:Name="BuildOnlyCheck" Content="Build only -- don't launch the editor" Margin="0,0,0,6"
                                  ToolTip="Compile but don't open the editor afterward."/>
                        <CheckBox x:Name="RebuildCheck" Content="Full rebuild (slow -- discards incremental progress)" Margin="0,0,0,6"
                                  ToolTip="Force a clean rebuild from scratch. Normally unnecessary and much slower -- use only if an incremental build is behaving strangely."/>
                        <CheckBox x:Name="SkipSyncCheckCheck" Content="Skip the pinned-version check" Margin="0,0,0,10"
                                  ToolTip="Build even if this copy doesn't match what the team pinned. For developers deliberately building an unpinned combination."/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="Configuration:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ConfigurationCombo" Width="150" SelectedIndex="0"
                                      ToolTip="Development is what you want unless you're debugging engine code.">
                                <ComboBoxItem Content="Development"/>
                                <ComboBoxItem Content="DebugGame"/>
                                <ComboBoxItem Content="Debug"/>
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="RunBuildButton" Content="Run Build" Width="140" Height="30" HorizontalAlignment="Left" Click="RunBuildButton_Click"
                                Background="{DynamicResource ForgeAccentBrush}" Foreground="{DynamicResource ForgeOnAccentBrush}"
                                ToolTip="Build (and launch, unless 'Build only' is checked) with the options above."/>

                        <TextBlock Text="Housekeeping" FontWeight="Bold" FontSize="14" Margin="0,28,0,10"/>
                        <Button x:Name="HousekeepingButton" Content="Housekeeping..." Width="160" Height="30" HorizontalAlignment="Left" Click="HousekeepingButton_Click"
                                ToolTip="See how much space DerivedDataCache/Intermediate are using, clean them, and prune the local LFS cache."/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="LogPage" Visibility="Collapsed" Margin="24">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource ToolbarCardStyle}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LogFilterAllButton" Content="All" Style="{StaticResource SegButtonStyle}" Click="LogFilter_Click" Tag="All"/>
                                <Button x:Name="LogFilterWarnButton" Content="Warnings" Style="{StaticResource SegButtonStyle}" Click="LogFilter_Click" Tag="Warnings"/>
                                <Button x:Name="LogFilterErrorButton" Content="Errors" Style="{StaticResource SegButtonStyle}" Click="LogFilter_Click" Tag="Errors"/>
                                <TextBox x:Name="LogSearchBox" Width="220" Margin="16,0,0,0" VerticalContentAlignment="Center"
                                         TextChanged="LogSearchBox_TextChanged" ToolTip="Filter log lines by text."/>
                                <Button x:Name="ClearLogButton" Style="{StaticResource ToolbarButtonStyle}" Click="ClearLogButton_Click" Margin="16,0,0,0"
                                        ToolTip="Clear this log view. Doesn't affect anything that already happened.">
                                    <TextBlock Text="Clear"/>
                                </Button>
                                <Button x:Name="CancelBuildButton" Click="CancelBuildButton_Click" Margin="16,0,0,0" Padding="10,5"
                                        Visibility="Collapsed" Background="{DynamicResource ForgeDangerFillBrush}" Foreground="{DynamicResource ForgeOnDangerBrush}"
                                        ToolTip="Force-stop the compiler. The build is left half-finished -- running Build again just resumes it.">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Alert24" Margin="0,0,6,0" Foreground="{DynamicResource ForgeOnDangerBrush}"/>
                                        <TextBlock Text="Cancel Build"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource ForgeSidebarBackgroundBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Padding="6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel" SelectionMode="Extended">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,1"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11"
                                                       Opacity="0.4" Width="56" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                                       Foreground="{Binding Brush}" Opacity="{Binding TextOpacity}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Margin" Value="0,8,0,2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </Grid>

                <Grid x:Name="WelcomePage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                        <ui:SymbolIcon Symbol="Fire24" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12"
                                       Foreground="{DynamicResource ForgeAccentBrush}"/>
                        <TextBlock Text="Forge" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Sync, build and manage your Unreal project's Git/LFS workflow without the command line."
                                   TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" Margin="0,0,0,28"/>

                        <Button Content="Open Project..." Height="38" Click="OpenProjectButton_Click"
                                Background="{DynamicResource ForgeAccentBrush}" Foreground="{DynamicResource ForgeOnAccentBrush}" Margin="0,0,0,10"
                                ToolTip="Pick a folder that's already set up for Forge."/>
                        <Button Content="Register a Project..." Height="38" Click="RegisterProjectButton_Click" Margin="0,0,0,28"
                                ToolTip="Point Forge at an Unreal project folder that isn't set up yet."/>

                        <TextBlock x:Name="WelcomeRecentHeader" Text="RECENT" FontSize="11" Opacity="0.5" Margin="0,0,0,8" Visibility="Collapsed"/>
                        <ItemsControl x:Name="WelcomeRecentList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Margin="0,0,0,6"
                                            MouseLeftButtonUp="WelcomeRecentItem_Click" Cursor="Hand" Tag="{Binding}">
                                        <TextBlock Text="{Binding}" Padding="12,10" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <Grid x:Name="HelpPage" Visibility="Collapsed" Margin="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Doc:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="HelpDocCombo" Width="280" Margin="0,0,8,0" SelectionChanged="HelpDocCombo_SelectionChanged"
                                      ToolTip="Project docs come from the open project's own config; Forge docs explain this app.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayText}" FontWeight="{Binding Weight}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="OpenExternalDocButton" Content="Open" Padding="10,4" Click="OpenExternalDocButton_Click" Visibility="Collapsed"
                                    ToolTip="Open this document in its own viewer (e.g. a PDF reader)."/>
                        </StackPanel>
                        <Grid>
                            <wv2:WebView2 x:Name="HelpWebView"/>
                            <TextBox x:Name="HelpFallbackText" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </Grid>
                    </DockPanel>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="24">
                    <StackPanel VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock x:Name="ThemeSubTab" Text="Theme" FontWeight="Medium" Margin="0,0,20,0" Cursor="Hand"
                                       MouseLeftButtonUp="SettingsSubTab_Click" Tag="Theme"
                                       Foreground="{DynamicResource ForgeAccentBrush}"/>
                            <TextBlock x:Name="GeneralSubTab" Text="General" Margin="0,0,20,0" Cursor="Hand"
                                       MouseLeftButtonUp="SettingsSubTab_Click" Tag="General"/>
                            <TextBlock x:Name="ProjectSubTab" Text="Project" Cursor="Hand"
                                       MouseLeftButtonUp="SettingsSubTab_Click" Tag="Project"/>
                        </StackPanel>

                        <StackPanel x:Name="ThemeTabContent">
                            <TextBlock Text="Mode" Opacity="0.7" FontSize="12" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button x:Name="ModeLightButton" Content="Light" Style="{StaticResource SegButtonStyle}" Click="ModeButton_Click" Tag="Light"/>
                                <Button x:Name="ModeDarkButton" Content="Dark" Style="{StaticResource SegButtonStyle}" Click="ModeButton_Click" Tag="Dark"/>
                                <Button x:Name="ModeSystemButton" Content="System" Style="{StaticResource SegButtonStyle}" Click="ModeButton_Click" Tag="System"/>
                            </StackPanel>

                            <TextBlock Text="LIGHT MODE" FontSize="11" Opacity="0.6" Margin="0,0,0,10"/>
                            <TextBlock Text="Accent" Opacity="0.7" FontSize="12" Margin="0,0,0,6"/>
                            <views:ThemeColorPicker x:Name="LightAccentPicker" Margin="0,0,0,14"/>
                            <TextBlock Text="Background" Opacity="0.7" FontSize="12" Margin="0,0,0,6"/>
                            <views:ThemeColorPicker x:Name="LightBackgroundPicker" Margin="0,0,0,14"/>
                            <TextBlock Text="Icon color" Opacity="0.7" FontSize="12" Margin="0,0,0,6"/>
                            <views:ThemeColorPicker x:Name="LightIconPicker" Margin="0,0,0,20"/>

                            <TextBlock Text="DARK MODE" FontSize="11" Opacity="0.6" Margin="0,0,0,10"/>
                            <TextBlock Text="Accent" Opacity="0.7" FontSize="12" Margin="0,0,0,6"/>
                            <views:ThemeColorPicker x:Name="DarkAccentPicker" Margin="0,0,0,14"/>
                            <TextBlock Text="Background" Opacity="0.7" FontSize="12" Margin="0,0,0,6"/>
                            <views:ThemeColorPicker x:Name="DarkBackgroundPicker" Margin="0,0,0,14"/>
                            <TextBlock Text="Icon color" Opacity="0.7" FontSize="12" Margin="0,0,0,6"/>
                            <views:ThemeColorPicker x:Name="DarkIconPicker" Margin="0,0,0,8"/>
                        </StackPanel>

                        <StackPanel x:Name="GeneralTabContent" Visibility="Collapsed">
                            <TextBlock Text="Git LFS locking" FontWeight="Medium" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,12"
                                       Text="Lets Forge show and manage Git LFS file locks -- who's editing what -- the same locks the editor sees. Only matters for projects that use LFS."/>
                            <CheckBox x:Name="EnableLfsLockingCheck" Content="Enable Git LFS lock management" Click="EnableLfsLockingCheck_Click"/>
                            <TextBlock x:Name="LfsAutoDetectNote" FontSize="11" Opacity="0.6" Margin="24,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="ProjectTabContent" Visibility="Collapsed">
                            <TextBlock Text="This project" FontWeight="Medium" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" Opacity="0.6" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProjectSettingsTitleText" Grid.Row="0" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Editor target" Opacity="0.6" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProjectSettingsTargetText" Grid.Row="1" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Folder" Opacity="0.6" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProjectSettingsRootText" Grid.Row="2" Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,4"/>
                            </Grid>

                            <TextBlock Text="Engine location" FontWeight="Medium" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="0,0,0,10"
                                       Text="By default Forge uses this project's bundled engine submodule. If this project doesn't distribute its own engine, point Forge at one installed elsewhere (Epic Games Launcher, a custom build). Personal to this machine -- never shared or committed."/>
                            <DockPanel Margin="0,0,0,6">
                                <Button Content="Browse..." DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0" Click="BrowseEnginePath_Click"/>
                                <TextBox x:Name="EnginePathBox" ToolTip="Folder containing Engine\Binaries\Win64\UnrealEditor.exe. Leave blank to use the bundled engine submodule."/>
                            </DockPanel>
                            <TextBlock x:Name="EnginePathStatusText" FontSize="11" Opacity="0.6" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SaveEnginePathButton" Content="Save" Width="90" Margin="0,0,8,0" Click="SaveEnginePath_Click"
                                        Background="{DynamicResource ForgeAccentBrush}" Foreground="{DynamicResource ForgeOnAccentBrush}"/>
                                <Button Content="Clear" Width="90" Click="ClearEnginePath_Click"
                                        ToolTip="Go back to using the bundled engine submodule."/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>

        <!-- Status bar: current background activity (project load/refresh,
             Sync, Build, Submit, etc) plus an indeterminate progress
             indicator. Buttons stay clickable while this is busy, see
             SetBusy/SetStatus. -->
        <Border Grid.Row="3" Background="{DynamicResource ForgeSidebarBackgroundBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <ProgressBar x:Name="StatusProgressBar" DockPanel.Dock="Right" IsIndeterminate="True"
                             Width="110" Height="4" Margin="10,0,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" Text="Ready" Opacity="0.7" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
